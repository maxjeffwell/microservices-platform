PORT=3006
NODE_ENV=development
LOG_LEVEL=info
SNAPSHOT_INTERVAL_MS=30000
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=k8s-allocation-producer
KAFKA_ALLOCATION_TOPIC=k8s.allocation
KAFKA_ALLOCATION_EVENTS_TOPIC=k8s.allocation.events
# GPU extended resource to track (slots requested vs node capacity)
GPU_RESOURCE_NAME=gpu.intel.com/i915
# Outside the cluster: KUBECONFIG=~/.kube/config (in-cluster uses the ServiceAccount)
