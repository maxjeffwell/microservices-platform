{
  "name": "k8s-allocation-producer",
  "version": "1.0.0",
  "description": "Publishes Kubernetes resource-allocation snapshots and scheduling/scaling events to Kafka (consumed into InfluxDB by analytics-service)",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon index.js",
    "start": "node index.js",
    "test": "NODE_ENV=test node --test tests/*.test.js"
  },
  "keywords": [
    "kubernetes",
    "kafka",
    "influxdb",
    "resource-allocation",
    "hpa",
    "scheduler"
  ],
  "author": "Jeff Maxwell <maxjeffwell@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@kubernetes/client-node": "^1.3.0",
    "@platform/logger": "file:../../../shared/logger",
    "dotenv": "^16.3.1",
    "kafkajs": "^2.2.4"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
